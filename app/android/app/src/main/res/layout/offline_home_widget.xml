<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@android:color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_mic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Voice command"
            android:src="@android:drawable/ic_btn_speak_now" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Offline Home"
            android:textColor="@android:color/black"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/fav0" style="@style/WidgetFavourite" />
    <TextView android:id="@+id/fav1" style="@style/WidgetFavourite" />
    <TextView android:id="@+id/fav2" style="@style/WidgetFavourite" />
    <TextView android:id="@+id/fav3" style="@style/WidgetFavourite" />
</LinearLayout>

      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"aliases\" (\"id\" TEXT NOT NULL, \"device_id\" TEXT NOT NULL REFERENCES devices (id) ON DELETE CASCADE, \"alias\" TEXT NOT NULL, \"lang\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"

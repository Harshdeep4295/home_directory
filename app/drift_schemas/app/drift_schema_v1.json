    {
      "name": "devices",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"devices\" (\"id\" TEXT NOT NULL, \"brand\" TEXT NOT NULL, \"protocol\" TEXT NOT NULL, \"ip\" TEXT NOT NULL, \"mac\" TEXT NULL, \"port\" INTEGER NULL, \"name\" TEXT NOT NULL, \"room_id\" TEXT NULL REFERENCES rooms (id) ON DELETE SET NULL, \"capabilities_json\" TEXT NOT NULL, \"dp_map_json\" TEXT NULL, \"native_countdown_max_s\" INTEGER NULL, \"default_auto_off_s\" INTEGER NULL, \"meta_json\" TEXT NOT NULL DEFAULT '{}', \"last_seen\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }

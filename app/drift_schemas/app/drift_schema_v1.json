          "sql": "CREATE TABLE IF NOT EXISTS \"timer_jobs\" (\"id\" TEXT NOT NULL, \"device_id\" TEXT NOT NULL REFERENCES devices (id) ON DELETE CASCADE, \"end_on\" INTEGER NOT NULL CHECK (\"end_on\" IN (0, 1)), \"fire_at\" TEXT NOT NULL, \"tier\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"meta_json\" TEXT NOT NULL DEFAULT '{}', \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
